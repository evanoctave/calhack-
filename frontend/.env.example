# Development proxy target. Private provider credentials stay on the backend.
NIGHTFALL_BACKEND_URL=http://127.0.0.1:8000

# Browser Maps JavaScript API key, restricted to this app's websites and Maps JS.
# Public browser configuration; never use a server/service-account key here.
VITE_GOOGLE_MAPS_API_KEY=
# DEMO_MAP_ID is suitable for local testing; use your own map ID for deployment.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
