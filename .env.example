# Copy to .env and fill in what you need. ./run.sh creates .env for you on first run.
# .env is gitignored and must never be committed. Leave a value blank to stay on the mock.

MOCK=1

# --- Anthropic -------------------------------------------------------------
# console.anthropic.com -> Settings -> API Keys. A Claude.ai Pro/Max subscription
# is NOT an API key; API access is billed separately.
ANTHROPIC_API_KEY=
# Dev 2, voice lane: redirect lines and brief prose
ANTHROPIC_MODEL=claude-sonnet-5
# Dev 1, vision lane: clothing description from the exit frame. Kept separate so
# the two lanes can change model independently.
ANTHROPIC_VISION_MODEL=claude-opus-5
VISION_TIMEOUT_S=8

# --- Cartesia (Dev 2: voice clone + speech to text) ------------------------
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# --- Twilio (Dev 2: outbound calls and SMS) --------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Apify (Dev 3: open-at-night places and hazards) -----------------------
APIFY_TOKEN=

# --- Moss (semantic memory) ------------------------------------------------
MOSS_API_KEY=

# --- Perception tuning (Dev 1) ---------------------------------------------
# Where exit snapshots are written. Gitignored.
SNAPSHOT_DIR=out/snapshots
# 0-255. A frame darker than this is never sent to the model; there is nothing
# in it to describe and the call would cost seconds to say so.
MIN_LUMINANCE=20
# Seconds with nobody visible, after a sighting in the door zone, before it counts
# as an exit. Lower it for a demo.
ABSENCE_S=10
# R1: the conversation goes quiet after this long with nobody ever at the door.
CONVERSATION_TIMEOUT_S=90

# --- Demo knobs ------------------------------------------------------------
# Signing key for brief links. Leave blank and a random one is generated per
# process, which means links break on restart. Set it to keep them working.
BRIEF_SECRET=
PUBLIC_URL=http://127.0.0.1:8000
# Seconds the door may stay open before it counts as an exit (default 20).
DOOR_WAIT_S=20
# Seconds each escalation tier waits for an ack (default 60).
ESCALATION_STEP_S=60
